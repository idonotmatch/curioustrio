DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
ANTHROPIC_API_KEY=your-anthropic-api-key
PORT=3002
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/gmail/callback
EMAIL_HASH_SECRET=generate-a-64-char-hex-secret
TOKEN_ENCRYPTION_KEY=generate-a-64-char-hex-key
CORS_ALLOWED_ORIGINS=
CRON_SECRET=generate-a-64-char-hex-secret
CRON_ALERT_WEBHOOK_URL=https://your-alerting-provider.example/webhook
SENTRY_DSN=https://public-key@your-sentry-host/project-id
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
FRESHNESS_EVENT_RETENTION_DAYS=30
APPLE_MAPS_KEY_ID=your-apple-maps-key-id
APPLE_MAPS_TEAM_ID=your-apple-team-id
APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
RECEIPT_SCAN_GUARDS_ENABLED=true
RECEIPT_SCAN_MINUTE_VELOCITY_LIMIT=5
RECEIPT_SCAN_MONTHLY_INCLUDED=150
RECEIPT_SCAN_GLOBAL_DAILY_LIMIT=500
RECEIPT_SCAN_GLOBAL_MONTHLY_LIMIT=5000
# Output tokens are weighted 5x to approximate current Haiku input/output cost.
RECEIPT_SCAN_GLOBAL_DAILY_WEIGHTED_TOKEN_LIMIT=10000000
RECEIPT_SCAN_GLOBAL_MONTHLY_WEIGHTED_TOKEN_LIMIT=100000000
# Reserved before a model call, then reconciled to actual usage.
RECEIPT_SCAN_ESTIMATED_WEIGHTED_TOKENS=50000
RECEIPT_SCAN_MAX_ATTEMPTS_PER_REQUEST=3
RECEIPT_SCAN_RESERVATION_STALE_MINUTES=5
RECEIPT_SCAN_CACHE_HOURS=24
# Private Supabase Storage bucket; the API service role creates it on first use.
RECEIPT_SCAN_STORAGE_BUCKET=receipt-scan-inputs
